# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys
# cp .env.template .env
# ─────────────────────────────────────────────

# NVIDIA NIM API Key (powers conversational LLM — meta/llama-3.1-8b-instruct)
# Get yours at: https://integrate.api.nvidia.com
NVIDIA_API_KEY=nvapi-your_key_here

# Gemini API Key (optional fallback)
GEMINI_API_KEY=

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/agentic_commerce
MONGODB_URI=

# Razorpay Test Mode Credentials
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here

# HMAC Receipt Signing Secret (any strong random string)
RECEIPT_SIGNING_KEY=your_secret_signing_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
